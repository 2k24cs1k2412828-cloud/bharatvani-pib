# ==============================================================================
# BharatVani - Environment Configuration Example
# ==============================================================================

PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional - for Article Caching & Newsroom Archive)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Environment Variables (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================================================
# D-ID Expressive V4 & Echo Sessions Configuration
# Documentation: https://docs.d-id.com/docs/echo-sessions-quickstart
# ==============================================================================
# Base URL for D-ID API (defaults to https://api.d-id.com)
DID_BASE_URL=https://api.d-id.com

# Your D-ID API Key (Base64 encoded "username:password" or API key string)
# Stored strictly on server; never exposed to frontend bundles
DID_API_KEY=

# The Agent ID for your photorealistic Expressive V4 presenter created in D-ID Studio
# e.g., agt_AbC123
DID_AGENT_ID=

# ==============================================================================
# LiveKit Realtime Transport (Managed by D-ID Echo Sessions)
# ==============================================================================
# Note: D-ID Echo Sessions automatically provision the LiveKit room and return
# the session_url, session_token, and echo_token upon session creation.
# If using a custom self-hosted LiveKit instance:
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
